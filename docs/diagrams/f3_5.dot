digraph{rankdir=LR;graph [dpi=200 fontname="Liberation Serif" pad=0.2]; node [fontname="Liberation Serif" fontsize=12 style=filled fillcolor="#eef3fa" color="#14365d"]; edge [fontname="Liberation Serif" fontsize=10 color="#14365d"]; node[shape=plain]
users[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#14365d"><font color="white"><b>users</b></font></td></tr><tr><td align="left"><u>id</u> PK<br align="left"/>username (unique)<br align="left"/>password_hash<br align="left"/>role<br align="left"/></td></tr></table>>]
items[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#14365d"><font color="white"><b>items</b></font></td></tr><tr><td align="left"><u>id</u> PK<br align="left"/>sku (unique)<br align="left"/>name, category, unit<br align="left"/>reorder_level<br align="left"/>qty, unit_cost, location<br align="left"/></td></tr></table>>]
sup[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#14365d"><font color="white"><b>suppliers</b></font></td></tr><tr><td align="left"><u>id</u> PK<br align="left"/>name (unique)<br align="left"/>phone<br align="left"/></td></tr></table>>]
bom[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#14365d"><font color="white"><b>bom</b></font></td></tr><tr><td align="left"><u>product_id</u> PK, FK<br align="left"/><u>material_id</u> PK, FK<br align="left"/>qty_per_unit<br align="left"/></td></tr></table>>]
tr[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#14365d"><font color="white"><b>transactions</b></font></td></tr><tr><td align="left"><u>id</u> PK<br align="left"/>item_id FK<br align="left"/>type, qty, balance_after<br align="left"/>reference, ts<br align="left"/>supplier_id FK<br align="left"/>user_id FK<br align="left"/></td></tr></table>>]
items->bom[label="1 : M (product)",arrowhead=crow];items->bom[label="1 : M (material)",arrowhead=crow]
